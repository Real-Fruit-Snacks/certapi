<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ApiTester.Core\ApiTester.Core.csproj" />
    <ProjectReference Include="..\ApiTester.Grpc\ApiTester.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- certapi browse: renders a page in WebView2 hosted on a plain Win32 window (no WinForms or
         WPF, so the command line keeps needing only the base .NET runtime). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApiTester.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>certapi</AssemblyName>
    <RootNamespace>ApiTester.Cli</RootNamespace>
    <Version>1.100.0</Version>
    <Product>certapi</Product>
    <Description>mTLS API client for the Windows certificate store</Description>
    <Authors>RFS</Authors>
    <Copyright>MIT</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Speed over download size: a compressed bundle is unpacked into memory on every launch, and
         without ReadyToRun every method is compiled as it is first called. Measured on Windows x64:
         the command line's `send` 240 ms → 134 ms and peak memory 89 → 46 MB; the app's window
         1.0 s → 0.73 s and 225 → 131 MB. The exes are about 2.5 times larger for it. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- WebView2Loader.dll travels inside the exe (msquic.dll still goes beside it). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Culture data from Windows itself (NLS) rather than ICU: loading ICU costs every command that
       formats a number or a date about 10 ms (measured on Windows x64: send 111 → 102 ms, certs
       85 → 75 ms). Number and date formatting, casing and IDN host names come out the same for
       what certapi prints; only culture-sensitive sorting can differ, and certapi compares
       ordinally. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>

  <!-- The WebView2 package also references its WinForms and WPF controls, which would make the
       command line depend on the Windows Desktop runtime. Only the core API is used here. -->
  <Target Name="DropWebView2UiControls" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.WinForms' or '%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <Import Project="..\MsQuicBesideExe.targets" />

</Project>
