<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ApiTester.Core\ApiTester.Core.csproj" />
    <ProjectReference Include="..\ApiTester.Grpc\ApiTester.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApiTester.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>certapi</AssemblyName>
    <RootNamespace>ApiTester.Cli</RootNamespace>
    <Version>1.95.0</Version>
    <Product>certapi</Product>
    <Description>mTLS API client for the Windows certificate store</Description>
    <Authors>RFS</Authors>
    <Copyright>MIT</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <Import Project="..\MsQuicBesideExe.targets" />

</Project>
