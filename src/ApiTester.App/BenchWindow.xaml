<Window x:Class="ApiTester.App.BenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Benchmark" Height="560" Width="760" MinHeight="420" MinWidth="600"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Text.Soft}"
        FontFamily="{StaticResource Mono}" FontSize="12.5"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="40" Background="{DynamicResource Bg.Panel}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_Drag">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="&#x276F;" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="BENCHMARK" FontWeight="Bold" FontSize="12" Margin="9,0,0,0"
                                   Foreground="{DynamicResource Text.Normal}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" HorizontalAlignment="Right" Style="{StaticResource CaptionClose}" Height="40" Click="Close_Click"/>
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,12,12">
                <Button x:Name="ExportCsvButton" Content="Export CSV…" Height="26" FontSize="11" Padding="10,0" IsEnabled="False" Click="ExportCsv_Click"/>
                <Button Content="Close" Height="26" FontSize="11" Padding="10,0" Margin="6,0,0,0" Click="Close_Click"/>
            </StackPanel>

            <DockPanel Margin="12">
                <TextBlock x:Name="TargetText" DockPanel.Dock="Top" Margin="0,0,0,8"
                           Foreground="{DynamicResource Text.Normal}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                        <TextBlock Text="Requests" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Text.Muted}"/>
                        <TextBox x:Name="CountBox" Width="64" Height="26" Text="100" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                        <TextBlock Text="Workers" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Text.Muted}"/>
                        <TextBox x:Name="ConcurrencyBox" Width="52" Height="26" Text="10" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                        <TextBlock Text="Warm-up (s)" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Text.Muted}"/>
                        <TextBox x:Name="WarmupBox" Width="52" Height="26" Text="0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                        <TextBlock Text="Rate (req/s)" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Text.Muted}"/>
                        <TextBox x:Name="RateBox" Width="64" Height="26" Text="" Tag="max" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="RunButton" Content="Run" Style="{StaticResource PrimaryButton}" Width="86" Height="26" Margin="0,0,0,4" Click="Run_Click"/>
                </WrapPanel>
                <TextBlock x:Name="ProgressText" DockPanel.Dock="Top" Margin="0,0,0,6"
                           Foreground="{DynamicResource Text.Muted}" FontSize="11.5"
                           Text="Ready. Connections are pooled and response bodies are drained without allocating."/>
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
                    <TextBox x:Name="ResultBox" IsReadOnly="True" AcceptsReturn="True" BorderThickness="0"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" Padding="10"/>
                </Border>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
