<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ RFS palette — Dayshift (light) ============ -->
    <!-- Same keys as Nightshift in TerminalWorkbench.xaml. This dictionary is merged over the base
         palette at runtime; every palette reference is a DynamicResource, so adding/removing this
         overlay repaints the whole UI live. Values from BRAND.md; Bg.Input, Border.Strong, Text.Soft
         and Text.Faint derived one step. Every accent is >= 4.5:1 on white. -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#F6F5F2"/>
    <SolidColorBrush x:Key="Bg.Panel"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bg.Input"    Color="#FAF9F7"/>
    <SolidColorBrush x:Key="Bg.Raised"   Color="#ECEAE4"/>
    <SolidColorBrush x:Key="Border"        Color="#D6D3CB"/>
    <SolidColorBrush x:Key="Border.Strong" Color="#BDB9AF"/>
    <SolidColorBrush x:Key="Accent"      Color="#C43F11"/>
    <SolidColorBrush x:Key="Accent.Alt"  Color="#9A6700"/>
    <SolidColorBrush x:Key="Warm"        Color="#9A6700"/>
    <SolidColorBrush x:Key="Signal"      Color="#167A4E"/>
    <SolidColorBrush x:Key="Text.Normal" Color="#1A1B1E"/>
    <SolidColorBrush x:Key="Text.Soft"   Color="#3A3C42"/>
    <SolidColorBrush x:Key="Text.Muted"  Color="#6B6F78"/>
    <SolidColorBrush x:Key="Text.Faint"  Color="#8E929B"/>
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Red"         Color="#C8324C"/>
    <SolidColorBrush x:Key="Accent.Hover"   Color="#D64D1E"/>
    <SolidColorBrush x:Key="Accent.Pressed" Color="#A83409"/>
    <SolidColorBrush x:Key="Accent.Tint"    Color="#F7DED3"/>

</ResourceDictionary>
