<Window x:Class="ApiTester.App.GrpcWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="gRPC Client" Height="640" Width="820" MinHeight="480" MinWidth="640"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Text.Soft}"
        FontFamily="{StaticResource Mono}" FontSize="12.5"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="40" Background="{DynamicResource Bg.Panel}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_Drag">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="&#x276F;" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="GRPC CLIENT" FontWeight="Bold" FontSize="12" Margin="9,0,0,0"
                                   Foreground="{DynamicResource Text.Normal}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" HorizontalAlignment="Right" Style="{StaticResource CaptionClose}" Height="40" Click="Close_Click"/>
                </Grid>
            </Border>

            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.3*" MinHeight="140"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button x:Name="DiscoverButton" DockPanel.Dock="Right" Content="Discover" Width="88" Height="30"
                            Margin="8,0,0,0" Click="Discover_Click"/>
                    <Button x:Name="ProtosetButton" DockPanel.Dock="Right" Content="Protoset…" Width="88" Height="30"
                            Margin="8,0,0,0" Click="Protoset_Click" ToolTip="Load a compiled .protoset descriptor file"/>
                    <TextBox x:Name="AddressBox" Height="30" VerticalContentAlignment="Center"
                             Tag="https://grpc.internal.corp:5001"/>
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <Button x:Name="CallButton" DockPanel.Dock="Right" Content="Call" Style="{StaticResource PrimaryButton}"
                            Width="88" Height="30" Margin="8,0,0,0" Click="Call_Click"/>
                    <ComboBox x:Name="MethodCombo" Height="30" IsEditable="True"
                              ToolTip="Service/Method (discovered via reflection or protoset, or typed directly)"/>
                </DockPanel>

                <TextBlock x:Name="StatusLine" Grid.Row="2" Margin="0,0,0,6"
                           Foreground="{DynamicResource Text.Muted}" FontSize="11.5"
                           Text="Enter a gRPC address and click Discover (server reflection) or load a .protoset."/>

                <TabControl Grid.Row="3">
                    <TabItem Header="Request JSON">
                        <TextBox x:Name="RequestBox" AcceptsReturn="True" BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12" Padding="8" Text="{}{}"/>
                    </TabItem>
                    <TabItem Header="Metadata (key: value)">
                        <TextBox x:Name="MetadataBox" AcceptsReturn="True" BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12" Padding="8"
                                 Tag="authorization: Bearer ...&#x0a;x-trace-id: 123"/>
                    </TabItem>
                </TabControl>

                <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                <Border Grid.Row="5" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
                    <TextBox x:Name="ResponseBox" IsReadOnly="True" AcceptsReturn="True" BorderThickness="0"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" Padding="10"/>
                </Border>

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Close" Height="26" FontSize="11" Padding="10,0" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
